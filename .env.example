# VCM Studio — variables d'environnement (copier en .env pour le local).
# En prod/dev Fly : les SECRETS passent par `fly secrets set` (jamais dans fly.toml),
# les non-secrets par [env] des fly.toml. Voir docs/DEPLOY.md.

# --- Secrets (obligatoires pour la génération réelle) ---
OPENAI_API_KEY=your_openai_key_here
REPLICATE_API_TOKEN=your_replicate_token_here

# --- Base de données ---
# Défaut = SQLite local. En prod, laisser VCM_STUDIO_DB vide et fournir DATABASE_URL
# (Postgres). VCM_STUDIO_DB est prioritaire s'il est défini ; une URL postgres://
# nue est réécrite en postgresql+psycopg:// automatiquement.
# VCM_STUDIO_DB=sqlite:///studio.db
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname

# --- Stockage des assets (vidéos/images/audio) ---
# Aujourd'hui : disque local sous VCM_OUTPUT_DIR (volume en prod).
VCM_OUTPUT_DIR=exports
# (À venir — object storage R2, cf. docs/DEPLOY.md « Étape suivante » :)
# STORAGE_BACKEND=local            # 'local' (défaut) | 'r2'
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# R2_BUCKET=vcm-assets-prod
# R2_PUBLIC_BASE=https://cdn.exemple.com
# R2_ACCESS_KEY_ID=...             # secret
# R2_SECRET_ACCESS_KEY=...         # secret

# --- Réseau / rendu ---
# URL externe atteignable par le process Remotion pour charger les assets.
VCM_RENDER_BASE=http://localhost:8000
# Origines navigateur autorisées (CORS), séparées par des virgules.
# Vide = défauts dev (localhost:5173).
# CORS_ORIGINS=https://vcm-studio-prod.fly.dev
